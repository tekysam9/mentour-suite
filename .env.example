# Copy this file to .env and fill in real values. Never commit .env itself.

# MySQL connection. On Hostinger, DB_HOST stays "localhost" — the app and
# database run on the same server. DB_NAME/DB_USER/DB_PASSWORD come from
# the database you create in hPanel (Databases -> Management); Hostinger
# prefixes whatever name you pick, so use the final prefixed values here.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mentour_suite
DB_USER=mentour_suite_user
DB_PASSWORD=changeme

# Signs session cookies. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Treat it like a password — don't reuse this placeholder.
SESSION_SECRET=changeme

# "production" on Hostinger (makes session cookies secure-only).
# Leave as "development" for local work.
NODE_ENV=development

# Hostinger sets this automatically in production; only needed locally.
PORT=3000
